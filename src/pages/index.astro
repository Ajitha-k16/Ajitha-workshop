---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const games = await getAllGames(getDatabase());
const publishers = await getAllPublishers(getDatabase());
const categories = [...new Map(
  games
    .flatMap((game) => game.category === null ? [] : [game.category])
    .map((category) => [category.id, category] as const),
).values()].sort((a, b) => a.name.localeCompare(b.name));
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <form class="mb-8 grid gap-6 rounded-xl border border-slate-700 bg-slate-800/60 p-6 md:grid-cols-2" data-testid="game-filters">
            <fieldset>
              <legend class="mb-3 text-lg font-medium text-slate-100">Filter by category</legend>
              <div class="grid gap-3 sm:grid-cols-2">
                {categories.map((category) => (
                  <label class="flex items-center gap-3 text-slate-300" data-testid={`category-filter-${category.id}`}>
                    <input
                      type="checkbox"
                      name="category"
                      value={category.id}
                      class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500"
                      data-filter-group="category"
                      data-testid={`category-filter-input-${category.id}`}
                    />
                    <span>{category.name}</span>
                  </label>
                ))}
              </div>
            </fieldset>

            <fieldset>
              <legend class="mb-3 text-lg font-medium text-slate-100">Filter by publisher</legend>
              <div class="grid gap-3 sm:grid-cols-2">
                {publishers.map((publisher) => (
                  <label class="flex items-center gap-3 text-slate-300" data-testid={`publisher-filter-${publisher.id}`}>
                    <input
                      type="checkbox"
                      name="publisher"
                      value={publisher.id}
                      class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-purple-500 focus:ring-2 focus:ring-purple-500"
                      data-filter-group="publisher"
                      data-testid={`publisher-filter-input-${publisher.id}`}
                    />
                    <span>{publisher.name}</span>
                  </label>
                ))}
              </div>
            </fieldset>

            <div class="flex items-center justify-between gap-4 md:col-span-2">
              <p class="text-sm text-slate-400" role="status" aria-live="polite" data-testid="filter-results-count">
                Showing {games.length} games
              </p>
              <button
                type="reset"
                class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
                data-testid="clear-filters"
              >
                Clear filters
              </button>
            </div>
          </form>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div class="hidden" data-testid="filtered-empty-state">
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const gameCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const gamesGrid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');
  const resultCount = document.querySelector<HTMLElement>('[data-testid="filter-results-count"]');

  if (filterForm && gamesGrid && emptyState && resultCount) {
    const updateResults = (): void => {
      const selectedCategories = new Set(
        Array.from(filterForm.querySelectorAll<HTMLInputElement>('input[data-filter-group="category"]:checked'))
          .map((input) => input.value),
      );
      const selectedPublishers = new Set(
        Array.from(filterForm.querySelectorAll<HTMLInputElement>('input[data-filter-group="publisher"]:checked'))
          .map((input) => input.value),
      );

      let visibleCount = 0;
      for (const card of gameCards) {
        const categoryMatches = selectedCategories.size === 0
          || selectedCategories.has(card.dataset.gameCategoryId ?? '');
        const publisherMatches = selectedPublishers.size === 0
          || selectedPublishers.has(card.dataset.gamePublisherId ?? '');
        const isVisible = categoryMatches && publisherMatches;

        card.classList.toggle('hidden', !isVisible);
        if (isVisible) visibleCount += 1;
      }

      gamesGrid.classList.toggle('hidden', visibleCount === 0);
      emptyState.classList.toggle('hidden', visibleCount !== 0);
      resultCount.textContent = `Showing ${visibleCount} game${visibleCount === 1 ? '' : 's'}`;
    };

    filterForm.addEventListener('change', updateResults);
    filterForm.addEventListener('reset', () => requestAnimationFrame(updateResults));
  }
</script>
